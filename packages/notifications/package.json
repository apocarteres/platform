    "@angular/core": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/router": "22.1.6",
    "@eslint/js": "^10.0.1",
    "@types/node": "22.18.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "28.0.0",
    "ng-packagr": "22.1.1",

<?xml version="1.0" encoding="UTF-8"?>
<!--
  REQ-QUALITY-002, REQ-DATA-ACCESS

  Исключения, которые ядро раздаёт само, потому что само же и обязало писать так,
  как разбор байт-кода не понимает. Разбор байт-кода ядром не предписан; этот файл
  нужен проекту, который добавил его сверх названного ядром набора.
-->
<FindBugsFilter>
  <!--
    Свод запросов отдаёт текст запроса переменной, а не литералом: разбор видит
    переменную и сообщает о внедрении SQL. Такой вид кода предписан
    REQ-DATA-ACCESS, поэтому исключение приходит оттуда же, откуда обязанность.
  -->
  <Match>
    <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    <Class name="~.*\.(dao|persistence)\..*"/>
  </Match>

  <!--
    Запись и значение отдают ссылку на переданный объект. Для типа-значения,
    который по REQ-CODE-DESIGN неизменяем, это не утечка представления.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Source name="~.*\.java"/>
  </Match>
</FindBugsFilter>

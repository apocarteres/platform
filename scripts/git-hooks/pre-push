#!/usr/bin/env bash
set -euo pipefail

# REQ-QUALITY-004: шлагбаум перед отправкой изменений — расписка о пройденном
# verify на отправляемое дерево кода. Набор гоняется один раз: mise run verify
# либо mise run verify-runner (CORE-OPS-088). Обход в исключительном случае:
# git push --no-verify.

# CORE-OPS-088: корень — рабочее дерево, из которого отправляют, а не место
# ссылки на хук: из отдельного рабочего дерева git зовёт хук общего каталога.
ROOT_DIR="$(git rev-parse --show-toplevel)"
EMPTY="0000000000000000000000000000000000000000"

# REQ-QUALITY-004, REQ-RELEASE-041: сверяется отправляемый диапазон, а не вся
# история. Сверка всей истории не дала бы отправить ничего проекту, у которого
# такой коммит уже отправлен: он исправляется вперёд, а не отказом на отправке.
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$EMPTY" ] && continue
  if [ "$remote_sha" = "$EMPTY" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  printf '[pre-push] conventions commits --range %s\n' "$range"
  node "$ROOT_DIR/packages/project-conventions/bin/conventions.mjs" commits --range "$range" --root "$ROOT_DIR"
  printf '[pre-push] conventions attested --commit %s\n' "$local_sha"
  node "$ROOT_DIR/packages/project-conventions/bin/conventions.mjs" attested --commit "$local_sha" --root "$ROOT_DIR"
done

# CORE-OPS-091: расписка переносится по дереву кода, а документы вне его;
# их согласованность проверяется здесь, как при закрытии выпуска (REQ-RELEASE-045).
printf '[pre-push] conventions docs-check\n'
node "$ROOT_DIR/packages/project-conventions/bin/conventions.mjs" docs-check --root "$ROOT_DIR"

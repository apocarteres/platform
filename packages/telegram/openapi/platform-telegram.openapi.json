{
  "openapi": "3.1.0",
  "info": {
    "title": "Telegram ядра",
    "version": "0.0.0",
    "description": "Контракт точек platform-telegram (REQ-TELEGRAM-012). Версия документа — версия ядра. Изменяющие запросы вошедшего требуют токена CSRF: cookie XSRF-TOKEN и заголовок X-XSRF-TOKEN; запрос браузера несёт X-Api-Version (REQ-CLIENT-UPDATE-006). Webhook удостоверяется секретным заголовком и токена CSRF не требует (REQ-TELEGRAM-003). Боты называются идентификатором из настроек (REQ-TELEGRAM-002)."
  },
  "paths": {
    "/api/telegram/links": {
      "get": {
        "summary": "Свои связи со всеми ботами службы",
        "x-clause": "REQ-TELEGRAM-009",
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Links"
                }
              }
            }
          },
          "401": {
            "description": "Вход не выполнен",
            "x-codes": [
              "authentication-required"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/telegram/{bot}/link": {
      "post": {
        "summary": "Одноразовая ссылка связи с ботом",
        "x-clause": "REQ-TELEGRAM-006",
        "description": "Новая выдача гасит прежнюю ссылку. Ссылка ведёт в бот с командой /start и токеном.",
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invitation"
                }
              }
            }
          },
          "401": {
            "description": "Вход не выполнен",
            "x-codes": [
              "authentication-required"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Нет токена CSRF",
            "x-codes": [
              "csrf-rejected"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Бот не объявлен",
            "x-codes": [
              "telegram-bot-not-found"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "Связь уже есть: сначала её снимают",
            "x-codes": [
              "telegram-already-linked"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "bot",
            "in": "path",
            "required": true,
            "description": "Идентификатор бота из platform.telegram.bots",
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,15}$"
            }
          }
        ]
      },
      "delete": {
        "summary": "Снять свою связь",
        "x-clause": "REQ-TELEGRAM-009",
        "description": "Снятие отсутствующей связи безвредно.",
        "responses": {
          "204": {
            "description": "Связи нет"
          },
          "401": {
            "description": "Вход не выполнен",
            "x-codes": [
              "authentication-required"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Нет токена CSRF",
            "x-codes": [
              "csrf-rejected"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Бот не объявлен",
            "x-codes": [
              "telegram-bot-not-found"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "bot",
            "in": "path",
            "required": true,
            "description": "Идентификатор бота из platform.telegram.bots",
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,15}$"
            }
          }
        ]
      }
    },
    "/api/telegram/{bot}/webhook": {
      "post": {
        "summary": "Обновление бота от Telegram",
        "x-clause": "REQ-TELEGRAM-004",
        "description": "Только для Telegram. Заголовок X-Telegram-Bot-Api-Secret-Token сверяется с секретом webhook. Модуль читает команду /start <токен> из личного чата; на прочее — 200 без тела. Ответ в чат приходит телом ответа методом sendMessage (REQ-TELEGRAM-008).",
        "parameters": [
          {
            "name": "bot",
            "in": "path",
            "required": true,
            "description": "Идентификатор бота из platform.telegram.bots",
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,15}$"
            }
          },
          {
            "name": "X-Telegram-Bot-Api-Secret-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Update"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Обновление принято; тело — ответ в чат или пусто",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reply"
                }
              }
            }
          },
          "401": {
            "description": "Секрет webhook неверен или не передан",
            "x-codes": [
              "identity-rejected"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Бот не объявлен",
            "x-codes": [
              "telegram-bot-not-found"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "429": {
            "description": "Превышен предел частоты; заголовок Retry-After",
            "x-codes": [
              "rate-limited"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "503": {
            "description": "Хранилище ограничителя недоступно: обновление отклонено, а не пропущено",
            "x-codes": [
              "rate-limit-unavailable"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/telegram/{bot}/login": {
      "post": {
        "summary": "Вход на сайт через Telegram Login Widget",
        "x-clause": "REQ-TELEGRAM-020",
        "description": "Тело — данные виджета как есть: id, first_name, last_name, username, photo_url, auth_date, hash. Подпись проверяется ключом из токена бота. Вход — только учётной записи, связанной с этим ботом; открывает обычную сессию ядра с её проверками и вторым шагом (REQ-AUTH-048). Требует токена CSRF.",
        "parameters": [
          {
            "name": "bot",
            "in": "path",
            "required": true,
            "description": "Идентификатор бота из platform.telegram.bots",
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,15}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginWidget"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успех: сессия открыта",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedIn"
                }
              }
            }
          },
          "401": {
            "description": "Подпись неверна или просрочена, связи нет — один ответ; либо нужен второй шаг: POST /api/auth/login/second-factor",
            "x-codes": [
              "credentials-rejected",
              "second-factor-required"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Нет токена CSRF, вход закрыт проектом, учётная запись заблокирована или почта не подтверждена",
            "x-codes": [
              "csrf-rejected",
              "entry-closed",
              "account-blocked",
              "email-unverified"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Бот не объявлен",
            "x-codes": [
              "telegram-bot-not-found"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "429": {
            "description": "Превышен предел частоты; заголовок Retry-After",
            "x-codes": [
              "rate-limited"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "503": {
            "description": "Хранилище ограничителя недоступно: вход отклонён, а не пропущен",
            "x-codes": [
              "rate-limit-unavailable"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Links": {
        "type": "object",
        "properties": {
          "bots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BotLink"
            }
          }
        },
        "required": [
          "bots"
        ]
      },
      "BotLink": {
        "type": "object",
        "properties": {
          "bot": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Имя бота в Telegram без @"
          },
          "linked": {
            "type": "boolean"
          },
          "linkedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "bot",
          "name",
          "linked",
          "linkedAt"
        ]
      },
      "Invitation": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "url",
          "expiresAt"
        ]
      },
      "LoginWidget": {
        "type": "object",
        "description": "Данные Telegram Login Widget",
        "properties": {
          "id": {
            "type": "integer"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "photo_url": {
            "type": "string"
          },
          "auth_date": {
            "type": "integer"
          },
          "hash": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "auth_date",
          "hash"
        ]
      },
      "SignedIn": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "email",
          "roles"
        ]
      },
      "Update": {
        "type": "object",
        "description": "Обновление Bot API; модуль читает message.chat, message.from и message.text",
        "properties": {
          "update_id": {
            "type": "integer"
          },
          "message": {
            "type": "object"
          }
        },
        "required": [
          "update_id"
        ]
      },
      "Reply": {
        "type": "object",
        "description": "Вызов Bot API в ответе webhook",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "sendMessage"
            ]
          },
          "chat_id": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "method",
          "chat_id",
          "text"
        ]
      },
      "ProblemDetail": {
        "type": "object",
        "description": "RFC 9457 с расширением code (REQ-API-001)",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ]
      }
    }
  }
}

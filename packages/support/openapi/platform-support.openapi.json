{
  "openapi": "3.1.0",
  "info": {
    "title": "Центр поддержки ядра",
    "version": "0.0.0",
    "description": "Контракт точек platform-support (REQ-SUPPORT-013). Версия документа — версия ядра. Изменяющие запросы требуют токена CSRF: cookie XSRF-TOKEN и заголовок X-XSRF-TOKEN. Запрос браузера несёт X-Api-Version (REQ-CLIENT-UPDATE-006)."
  },
  "paths": {
    "/api/support/requests": {
      "post": {
        "summary": "Отправить обращение",
        "x-clause": "REQ-SUPPORT-001",
        "description": "Вошедший — от своей учётной записи, невошедший — с почтой, если проект открыл приём без входа (REQ-SUPPORT-002). Предел тела и ограничитель по сети проверяются до разбора (REQ-SUPPORT-003).",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "request": {
                    "$ref": "#/components/schemas/Submission"
                  },
                  "files": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                },
                "required": [
                  "request"
                ]
              },
              "encoding": {
                "request": {
                  "contentType": "application/json"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Принято",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Submitted"
                }
              }
            }
          },
          "400": {
            "description": "Текст, почта или вложения не приняты",
            "x-codes": [
              "message-rejected",
              "guest-email-rejected",
              "attachment-rejected"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Приём без входа закрыт проектом либо нет токена CSRF",
            "x-codes": [
              "guest-intake-closed",
              "csrf-rejected"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "411": {
            "description": "Длина тела не объявлена",
            "x-codes": [
              "length-required"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "413": {
            "description": "Тело больше предела обращения",
            "x-codes": [
              "body-too-large"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "429": {
            "description": "Превышен предел частоты; заголовок Retry-After",
            "x-codes": [
              "rate-limited"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "503": {
            "description": "Хранилище ограничителя недоступно: действие отклонено, а не пропущено",
            "x-codes": [
              "rate-limit-unavailable"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Мои обращения",
        "x-clause": "REQ-SUPPORT-012",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20

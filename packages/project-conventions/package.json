{
  "name": "@apocarteres/project-conventions",
  "version": "0.0.0",
  "description": "Правила ведения проекта и их проверки: нормативные документы, указатель на них в AGENTS.md, храповик существующих нарушений, правила проекта поверх платформенных.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apocarteres/platform.git",
    "directory": "packages/project-conventions"
  },
  "files": [
    "bin",
    "lib",
    "configs",
    "docs",
    "obligations.json",
    "README.md",
    "changes.json"
  ],
  "type": "module",
  "bin": {
    "conventions": "bin/conventions.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepack": "node scripts/collect-docs.mjs && node scripts/collect-changes.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  },
  "exports": {
    ".": "./lib/rules.mjs",
    "./configs/eslint": "./configs/eslint.base.mjs",
    "./configs/clippy": "./configs/clippy.toml",
    "./configs/spotbugs-exclude": "./configs/spotbugs-exclude.xml",
    "./configs/cargo-lints": "./configs/cargo-lints.toml"
  }
}
